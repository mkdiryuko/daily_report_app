<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <h2><%= currentDate %></h2>
    <form action="/">
      <label>JobNo</label>
      <select id="jobNo" name="jobNo" onchange="changeJobName()" required>
        <option value="" selected disabled></option>
        <% for(i=0; i<jobs.length; i++) { %>
          <option value="<%= jobs[i].id %>" data-jobname="<%= jobs[i].name %>">
            <%= jobs[i].jobno + ":" + jobs[i].name %>
          </option>
        <% }; %>
      </select>
      <br />
      <label>案件名</label>
      <input type="text" id="jobName" disabled required>
      <script>
        function changeJobName() {
          const jobNo = document.getElementById('jobNo');
          const jobNameInput = document.getElementById('jobName');
          
          // 選択されたオプションを取得
          const selectedOption = jobNo.options[jobNo.selectedIndex];
          
          // data-jobname属性から案件名を取得
          const jobName = selectedOption.getAttribute('data-jobname');
          
          // 案件名の入力フィールドを更新
          jobNameInput.value = jobName;
        }
      </script>
      <br>
      <label>作業内容</label>
      <select name="job_desc">
        <option value="" selected disabled required></option>
        <% for(i=0; i<job_desc.length; i++) { %>
          <option value="<%= job_desc[i].id %>"><%= job_desc[i].name %></option>
        <% }; %>
      </select>
      <br />
      <label>工数</label>
      <select name="Kousuu">
        <option value="" selected disabled></option>
        <% for(let hour = 0; hour < 20; hour += 1.0) { %>
          <% for(let min = 0; min < 60; min += 15) { %>
            <option value="<%= hour.toString()+min.toString() %>"><%= hour %>:<%= min === 0 ? "00" : min %></option>
          <% } %>
        <% } %>
      </select>
      <br />
      <label>備考</label>
      <br />
      <textarea name="note" rows="5" cols="40"></textarea>
      <br>
      <button class="btn">確定</button>
    </form>
  </body>
</html>
