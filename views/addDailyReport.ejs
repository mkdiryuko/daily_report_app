<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
  </head>
  <body>
    <div class="container">
      <div class="row">
        <div class="col">
          <h2><%= currentDate %></h2>
            <!-- Button trigger modal -->
            <button type="button" class="btn btn-primary btn-sm mb-3" data-bs-toggle="modal" data-bs-target="#job_reference">
              案件を検索する
            </button>
            <!-- Modal -->
            <div class="modal fade" id="job_reference" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">JobNo＆案件名</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    <select id="jobs" name="jobNo">
                      <option value="" hidden>選択</option>
                      <% for(i=0; i<jobs.length; i++) { %>
                        <option value="<%= jobs[i].id %>" data-jobno="<%= jobs[i].jobno %>" data-jobname="<%= jobs[i].name %>">
                          <%= jobs[i].jobno + " " + jobs[i].name %>
                        </option>
                      <% }; %>
                    </select>
                    <br>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
                    <button type="button" class="btn btn-primary" onclick="displayJobs()" data-bs-dismiss="modal">保存</button>
                  </div>
                </div>
              </div>
            </div>
          <br>
          <form action="/" onsubmit="return validationForm()">
            <div class="mb-2">
              <label>JobNo</label>
              <input type="text" name="jobNo" id="jobNoText" readonly>
            </div>
            <div class="mb-2">
              <label>案件名</label>
              <input type="text" name="jobName" id="jobNameText" readonly>
            </div>
            <div class="mb-2">
              <label>作業内容</label>
              <select name="job_desc" required>
                <option value="" hidden>選択</option>
                <% for(i=0; i<job_desc.length; i++) { %>
                  <option value="<%= job_desc[i].id %>"><%= job_desc[i].name %></option>
                <% }; %>
              </select>
            </div>
            <div class="mb-2">
            <label>工数</label>
              <select name="person_hour" required>
                <option value="" hidden>選択</option>
                <% for(let hour = 0; hour < 20; hour += 1.0) { %>
                  <% for(let min = 0; min < 60; min += 15) { %>
                    <option value="<%= hour.toString()+min.toString() %>"><%= hour %>:<%= min === 0 ? "00" : min %></option>
                  <% } %>
                <% } %>
              </select>
            </div>
            <label>備考</label>
            <div class="mb-2">
              <textarea name="note" rows="3" cols="40"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">確定</button>
          </form>
        </div>
      </div>
    </div>
  </body>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
  <script>
    function displayJobs() {
      const jobs = document.getElementById('jobs');
      const jobNoText = document.getElementById("jobNoText");
      const jobNameText = document.getElementById("jobNameText");
      // 選択されたオプションを取得
      const selectedJob = jobs.options[jobs.selectedIndex];
      // jobNoと案件名を取得
      const jobNo = selectedJob.getAttribute('data-jobno');
      const jobName = selectedJob.getAttribute('data-jobname')
      // 案件名の入力フィールドを更新
      jobNoText.value = jobNo;
      jobNameText.value = jobName;
    }
    function validationForm() {
      const jobNoText = document.getElementById("jobNoText");
      const jobNameText = document.getElementById("jobNameText");
      if (jobNoText.value.trim() === "" || jobNameText.value.trim() === "") {
        alert("jobNoと案件名は必須です");
        return false;
      }
      return true;
    }
  </script>
</html>
