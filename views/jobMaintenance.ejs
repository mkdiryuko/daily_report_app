<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Document</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    </head>
    <body>
        <div class="container">
            <div class="row">
                <h2>案件管理</h2>
                <div class="col">
                    <table class="table table-striped table-hover table-bordered">
                        <thead>
                        <tr>
                            <th scope="col">jobno</th>
                            <th scope="col">案件名</th>
                            <th scope="col">開始日</th>
                            <th scope="col">終了日</th>
                            <th scope="col"></th>
                            <th scope="col"></th>
                        </tr>
                        </thead>
                        <% for (i=0; i<jobs.length; i++) { %>
                            <tbody>
                                <tr>
                                    <td><%= jobs[i].jobno %></td>
                                    <td><%= jobs[i].name %></td>
                                    <td><%= jobs[i].start_date %></td>
                                    <td><%= jobs[i].end_date %></td>
                                    <td>
                                        <button type="button" class="btn btn-primary w-100">
                                            編集
                                        </button>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-warning w-100" data-bs-toggle="modal" data-bs-target="#deleteJobModal<%= i %>">
                                            削除
                                        </button>
                                        <!-- 削除モーダル -->
                                        <div class="modal fade" id="deleteJobModal<%= i %>" tabindex="-1" aria-labelledby="deleteJobModalLabel<%= i %>" aria-hidden="true">
                                            <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                <h1 class="modal-title fs-5" id="deleteJobModalLabel<%= i %>">案件削除</h1>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="container">
                                                        <div class="row mb-2">
                                                            <div class="col-3">
                                                                <label>jobno</label>
                                                            </div>
                                                            <div class="col-auto">
                                                                <input type="text" value="<%= jobs[i].jobno %>">
                                                            </div>
                                                        </div>
                                                        <div class="row mb-2">
                                                            <div class="col-3">
                                                                <label>案件名</label>
                                                            </div>
                                                            <div class="col-auto">
                                                                <input type="text" value="<%= jobs[i].name %>">
                                                            </div>
                                                        </div>
                                                        <div class="row mb-2">
                                                            <div class="col-3">
                                                                <label>開始日</label>
                                                            </div>
                                                            <div class="col-auto">
                                                                <input type="date" value="<%= jobs[i].start_date.replace(/\//g, '-') %>">
                                                            </div>
                                                        </div>
                                                        <div class="row mb-2">
                                                            <div class="col-3">
                                                                <label>終了日</label>
                                                            </div>
                                                            <div class="col-auto">
                                                                <input type="date" value="<%= jobs[i].end_date.replace(/\//g, '-') %>">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
                                                <button type="button" class="btn btn-primary">確定</button>
                                                </div>
                                            </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        <% }; %>
                    </table>
                </div>
            </div>
        </div>
    </body>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
</html>