<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head.ejs'); %>
  </head>
  <body>
    <%- include('partials/header.ejs'); %>
    <%- include('partials/sidebar.ejs'); %>
    <main>
      <h2>案件管理</h2>
        <div id="jobs">
          <input class="search mb-2" placeholder="キーワード検索" />
          <table class="table table-borderless">
            <tr>
              <th>jobno</th>
              <td><input type="text" value=""></td>
              <th>開始日</th>
              <td><input type="date" name="date" class="date-input"></td>
              <td>
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="flexRadioStart" id="flexRadioStart1">
                    <label class="form-check-label" for="flexRadioStart1">
                      以前
                    </label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="flexRadioStart" id="flexRadioStart2" checked>
                    <label class="form-check-label" for="flexRadioStart2">
                      以後
                    </label>
                  </div>
              </td>
              <td><button>検索</button></td>
            </tr>
            <tr>
              <th>案件名</th>
              <td><input type="text"></td>
              <th>終了日</th>
              <td><input type="date" name="date" class="date-input"></td>
              <td>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="flexRadioEnd" id="flexRadioEnd1">
                  <label class="form-check-label" for="flexRadioEnd1">
                    以前
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="flexRadioEnd" id="flexRadioEnd2" checked>
                  <label class="form-check-label" for="flexRadioEnd2">
                    以後
                  </label>
                </div>
              </td>
            </tr>
          </table>
          <table class="table table-striped table-hover table-bordered">
            <thead>
              <tr>
                <th scope="col" data-sort="jobno" class="sort">jobno</th>
                <th scope="col" data-sort="name">案件名</th>
                <th scope="col" data-sort="start_date" class="sort">開始日</th>
                <th scope="col" data-sort="end_date" class="sort">終了日</th>
                <th scope="col"></th>
                <th scope="col"></th>
              </tr>
            </thead>
              <tbody class="list">
                  <% for (i=0; i<jobs.length; i++) { %>
                    <tr>
                      <td class="jobno"><%= jobs[i].jobno %></td>
                      <td class="name"><%= jobs[i].name %></td>
                      <td class="start_date"><%= jobs[i].start_date %></td>
                      <td class="end_date"><%= jobs[i].end_date %></td>
                      <td>
                        <button type="button" class="btn btn-primary w-100 edit">
                          編集
                        </button>
                      </td>
                      <td>
                        <button type="button" class="btn btn-danger w-100 delete" data-bs-toggle="modal" data-bs-target="#deleteJobModal<%= i %>">
                          削除
                        </button>
                        <!-- 削除モーダル -->
                        <div class="modal fade" id="deleteJobModal<%= i %>" tabindex="-1" aria-labelledby="deleteJobModalLabel<%= i %>" aria-hidden="true">
                          <div class="modal-dialog">
                            <div class="modal-content">
                              <div class="modal-header">
                                <h4 class="modal-title" id="deleteJobModalLabel<%= i %>">
                                  本当に削除してもよろしいですか？<br>
                                  <% if (relationJobnoIdList.includes(jobs[i].id.toString())) { %>
                                    <font style="color: red;">(※)該当案件での日報登録が存在します</font>
                                  <% }; %>
                                </h4>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                              </div>
                              <div class="modal-body">
                                <div class="container">
                                  <div class="row mb-2">
                                    <div class="col-3">
                                      <label>jobno</label>
                                    </div>
                                    <div class="col">
                                      <input type="text" value="<%= jobs[i].jobno %>" readonly>
                                    </div>
                                  </div>
                                  <div class="row mb-2">
                                    <div class="col-3">
                                      <label>案件名</label>
                                    </div>
                                    <div class="col">
                                      <input type="text" value="<%= jobs[i].name %>" readonly>
                                    </div>
                                  </div>
                                  <div class="row mb-2">
                                    <div class="col-3">
                                      <label>開始日</label>
                                    </div>
                                    <div class="col">
                                      <input type="date" value="<%= jobs[i].start_date.replace(/\//g, '-') %>" readonly>
                                    </div>
                                  </div>
                                  <div class="row mb-2">
                                    <div class="col-3">
                                      <label>終了日</label>
                                    </div>
                                    <div class="col">
                                      <input type="date" value="<%= jobs[i].end_date.replace(/\//g, '-') %>" readonly>
                                    </div>
                                  </div>
                                </div>
                              </div>
                                <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
                                <button type="button" class="btn btn-danger" id="deleteJobButton" data-id="<%= jobs[i].id %>">削除</button>
                              </div>
                            </div>
                          </div>
                        </div>
                      </td>
                    </tr>
                  <% }; %>
              </tbody>
            </table>
        </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
  <script src="//cdnjs.cloudflare.com/ajax/libs/list.js/2.3.1/list.min.js"></script>
  <script src="../js/layout.js"></script>
  <script>
    let options = {
      valueNames: [ 'jobno', 'name', 'start_date', 'end_date' ]
    };
    let jobList = new List('jobs', options);
  </script>
  <script>
    // 現在の日付をYYYY-MM-DDの形式で取得
    const today = new Date();
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, '0');
    const dd = String(today.getDate()).padStart(2, '0');
    const formattedDate = `${yyyy}-${mm}-${dd}`;

    const dateInputs = document.querySelectorAll('.date-input');
    dateInputs.forEach(input => {
      input.value = formattedDate;
    });
  </script>
  <script>
    // モーダルの削除ボタンを押す→案件を削除してもいいという命令
    document.getElementById('deleteJobButton').addEventListener('click', async () => {
      const recordId = document.getElementById('deleteJobButton').dataset.id;

      try {
        const response = await fetch(`jobMaintenance/delete`, {
          method: `POST`,
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ id: recordId })
        });

        const result = await response.json();

        if (response.ok) {
          alert(result.message);
        } else {
          alert(`エラー: ${ result.message }`);
        }
      } catch (error){
        console.error("Error:", error);
        alert('案件の削除に失敗しました(DB)');
      }
    })
  </script>
  <style>
    .sort.desc:after {
      content: "▼";
    }

    .sort.asc:after {
      content: "▲";
    }
  </style>
</body>
</html>