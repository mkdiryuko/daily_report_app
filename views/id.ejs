<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Azure AD</h1>
    <h3>ID Token</h3>
    <table>
        <tbody>
            <% Object.entries(idTokenClaims).forEach(([key, value]) => { %>
            <tr>
                <td><%= key %></td>
                <td><%= value %></td>
            </tr>
            <% }); %>
        </tbody>
    </table>
    <br>
    <a href="https://aka.ms/id-tokens" target="_blank">Learn about claims in this ID token</a>
    <br>
    <a href="/">Go back</a>
</body>
</html>