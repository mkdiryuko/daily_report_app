<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head.ejs'); %>
  <link rel="stylesheet" href="../css/main.css">
  <link rel="stylesheet" href="../css/modal.css">
</head>
<body>
  <%- include('partials/header.ejs'); %>
  <%- include('partials/sidebar.ejs'); %>

  <main>
    <h3>工数登録</h3>
    <div class="date-wrapper">
      <div class="left-group">
        <div class="triangle-btn prev" id="prev-btn"></div>
        <input type="date" id="date-input">
        <div class="triangle-btn next" id="next-btn"></div>
        <div class="work-hours-container">
          <span>実労働時間：</span>
          <div class="work-hours-time">3:30</div>
        </div>
      </div>
      <div class="right-group">
          <button class="openHolidayModal">休暇申請</button>
      </div>
    </div>
    <!-- DBからレコードを取得し、日付でフィルタリング後、表示する-->
    <div class="table-container">
      <div class="table-header">
        <div class="table-title">作業工数</div>
        <button class="openModal">工数登録</button>
      </div>
      <table border="1">
        <thead>
          <tr>
            <th scope="col">No.</th>
            <th scope="col">内容</th>
            <th scope="col"></th>
            <th scope="col">時間</th>
          </tr>
        </thead>
        <tbody>
          <td scope="row" rowspan="7" class="table-no">001</td>
          <tr>
            <th scope="row">作業内容</th>
            <td class="item-table__data">設計</td>
            <td rowspan="2" align="center">
              <div class="time-container">
                <div id="time">3:30</div>
              </div>
            </td>
          </tr>
          <tr>
            <th scope="row">JobNo</th>
            <td class="item-table__data">2300513</td>
          </tr>
          <tr>
            <th scope="row">案件</th>
            <td class="item-table_data">ALAP_iDB_ホンダMBA-FMT作業委託 4月</td>
            <td rowspan="2" align="center">
                <button class="edit-btn openEditModal">編集</button>
            </td>
          </tr>
          <tr>
            <th scope="row">備考</th>
            <td><textarea name="textarea" id="textarea" rows="3" readonly></textarea></td>
          </tr>
        </tbody>
      </table>
    </div>
    <div id="modal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <div class="modal-header">
          工数登録
        </div>
        <!-- 案件検索ボタンを配置し、ドロップダウンから検索できるようにする-->
        <button>案件検索</button>
        <form id="modalForm" class="modal-form">
          <label for="JobNo" class="modal-form__label">JobNo</label>
          <input type="text" name="jobNo" id="JobNo" class="form-control">
          <br>
          <label for="jobName" class="modal-form__label">案件名</label>
          <input type="text" name="jobName" id="jobName" class="form-control">
          <br>
          <label for="job_desc" class="modal-form__label">作業内容</label>
          <select name="job_desc" id="job_desc" class="form-control" required>
            <option value="" hidden>選択</option>
            <option value="">設計</option>
            <option value="">テスト</option>
            <option value="">コーディング</option>
          </select>
          <br>
          <label for="" class="modal-form__label">備考</label>
          <textarea name="note" rows="3" cols="40" class="form-control"></textarea>
          <br>
        </form>
        <div class="modal-footer">
          <button class="submit-btn">登録</button>
          <button class="cancel-btn">キャンセル</button>
        </div>
      </div>
    </div>
  </main>
  <!-- js -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script type="text/javascript" src="../js/layout.js"></script>
  <script type="text/javascript" src="../js/main.js"></script>
  <script type="text/javascript" src="../js/modal.js"></script>
</body>
</html>