<!DOCTYPE html>
<html lang="ja">
<head>
  <%- include('partials/head.ejs'); %>
  <link rel="stylesheet" href="../css/pages/main.css">
</head>
<body>
  <%- include('partials/header.ejs'); %>
  <%- include('partials/sidebar.ejs'); %>

  <main>
    <% if(messages.success){ %>
      <div class="alert alert-success" role="alert">
        <%= messages.success %>
        <button class="close-btn" onclick="this.parentElement.style.display='none'">&times;</button>
      </div>
    <% } %> 

    <h3>工数登録</h3>
    <!-- 日付選択 -->
    <div class="date-wrapper">
      <div class="left-group">
        <div class="triangle-btn prev" id="prev-btn"></div>
        <input type="date" id="date-input" value="<%= selectedDate %>">
        <div class="triangle-btn next" id="next-btn"></div>
        <div class="work-hours-container">
          <span>実労働時間：</span>
          <div class="work-hours-time"><%= total_person_hour %></div>
        </div>
      </div>
      <!-- 休暇申請 -->
      <div class="right-group">
        <% if (absence) { %>
          <h4 style="color: red;">休暇申請を受領</h3>
        <% } %>
        <% if (daily_reports.length > 0) { %>
          <button id="open-absence-modal-btn" class="openAbsenceModal" type="button" disabled style="background-color: darkgray;">休暇申請</button>
        <% } else { %>
          <button id="open-absence-modal-btn" class="openAbsenceModal" type="button">休暇申請</button>
        <% } %>
        </div>
    </div>

    <!-- 作業工数テーブル -->
    <div class="table-container">
      <div class="table-header">
        <div class="table-title">作業工数</div>
        <% if( absence ) { %>
          <button class="openModal" id="open-reg-modal-btn" type="button" disabled style="background-color: darkgray;">工数登録</button>
        <% } else { %>
          <button class="openModal" id="open-reg-modal-btn" data-type="register" onclick="selectModal('register')" type="button">工数登録</button>
        <% } %>
      </div>
      <table border="1">
        <thead>
          <tr>
            <th scope="col">No.</th>
            <th scope="col">内容</th>
            <th scope="col"></th>
            <th scope="col">時間</th>
          </tr>
        </thead>
        <% for(i=0; i<daily_reports.length; i++) { %>
        <tbody>
          <td scope="row" rowspan="7" class="table-no">00<%= i+1 %></td>
          <tr>
            <th scope="row">作業内容</th>
            <td class="item-table__data"><%= daily_reports[i].job_desc_name %></td>
            <td rowspan="2" align="center">
              <div class="time-container">
                <div id="time"><%= daily_reports[i].person_hour.slice(0, 5) %></div>
              </div>
            </td>
          </tr>
          <tr>
            <th scope="row">JobNo</th>
            <td class="item-table__data"><%= daily_reports[i].jobno %></td>
          </tr>
          <tr>
            <th scope="row">案件</th>
            <td class="item-table_data"><%= daily_reports[i].job_name %></td>
            <td rowspan="2" align="center">
                <button class="edit-btn openModal" id="open-edit-modal-btn<%= daily_reports[i].id %>" data-type="edit" onclick="selectModal('edit','<%= daily_reports[i].id %>')">編集</button>
                <br>
                <button class="delete-btn openModal" id="open-del-modal-btn<% daily_reports[i].id %>" data-type="delete" onclick="selectModal('delete', '<%= daily_reports[i].id %>')">削除</button>
            </td>
          </tr>
          <tr>
            <th scope="row">備考</th>
            <td><textarea name="textarea" class="table-textarea" id="note" rows="3" readonly><%= daily_reports[i].note %></textarea></td>
          </tr>
        </tbody>
        <% }; %>
      </table>
    </div>

    <!-- 工数登録モーダル -->
    <div id="modal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <div class="modal-header" id="modal-header">
          工数登録
        </div>
        <div class="dropdown">
          <button id="job-search-btn">案件検索</button>
          <div class="dropdown-menu" id="job-search-dropdownMenu">
            <ul>
              <% for(i=0; i<jobs.length; i++) { %>
                <li data-jobno="<%= jobs[i].jobno %>" data-jobname="<%= jobs[i].name %>"><%= jobs[i].jobno + " " + jobs[i].name %></li>
              <% }; %>
            </ul>
          </div>
        </div>
        <form id="modalForm" class="modal-form" method="post">
          <label for="jobNo" class="modal-form__label">JobNo</label>
          <input type="text" name="jobNo" id="jobNo" class="form-control" readonly required>
          <br>
          <label for="jobName" class="modal-form__label">案件名</label>
          <input type="text" name="jobName" id="jobName" class="form-control" readonly required>
          <br>
          <label for="job_desc_dropdown" class="modal-form__label">作業内容</label>
          <select id="job_desc_dropdown" name="job_desc" class="form-control" required>
            <option value="" disabled selected hidden>選択</option>
            <% for(i=0; i<job_descs.length; i++) { %>
              <option value="<%= job_descs[i].name %>"><%= job_descs[i].name %></option>
            <% }; %>
          </select>
          <label for="person_hour_dropdown" class="modal-form__label">工数</label>
          <select id="person_hour_dropdown" name="person_hour" class="form-control" required>
            <option value="" disabled selected hidden>選択</option>
            <% for(let hour = 0; hour < 20; hour += 1.0) { %>
              <% for(let min = 0; min < 60; min += 15) { %>
                <option value="<%= hour.toString().padStart(2, '0') %>:<%= min === 0 ? "00" : min %>">
                  <%= hour.toString().padStart(2, '0') %>:<%= min === 0 ? "00" : min %>
                </option>
              <% } %>
            <% } %>
          </select>
          <br>
          <label for="note" class="modal-form__label">備考</label>
          <textarea name="note" rows="3" cols="40" id="modal_note" class="form-control"></textarea>
          <br>
        </form>
        <div class="modal-footer">
          <button class="submit-btn" id="submit-btn" type="submit" form="modalForm">登録</button>
          <button class="cancel-btn" type="button">キャンセル</button>
        </div>
      </div>
    </div>
  </main>

  <!-- 休暇申請モーダル -->
  <div id="absence-modal", class="modal", data-absence="<%= absence %>">
    <div class="modal-content">
      <span class="close">&times;</span>
      <div id="absence-modal-header" class="modal-header">
        休暇申請
      </div>
      <form id="absenceModalForm" class="modal-form" method="post" action="main/absence">
        <input type="text" value="<%= selectedDate %>" class="form-control" name="date" readonly>
        <label for="reason" class="modal-form__label">申請理由(未記入でも可)</label>
        <textarea name="reason" rows="3" cols="40" id="reason" class="form-control" name="reason"></textarea>
      </form>
      <div class="modal-footer">
        <button class="submit-btn" id="absence-submit-btn" type="submit" form="absenceModalForm">申請</button>
        <button class="cancel-btn" type="button">キャンセル</button>
      </div>
    </div>
  </div>
  <!-- js -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script type="text/javascript" src="../js/layout.js"></script>
  <script type="text/javascript" src="../js/main.js"></script>
  <script type="text/javascript" src="../js/modal.js"></script>
</body>
</html>